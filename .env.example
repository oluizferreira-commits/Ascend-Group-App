# ─── Banco de dados ─────────────────────────────────────────────
# Qualquer PostgreSQL 14+ (local, Supabase, Neon...). Para o Supabase use a
# "connection string" do pooler em modo "session" (porta 5432).
DATABASE_URL=postgres://ascend:ascend@localhost:5432/ascend

# Banco usado somente pelos testes de integração (é apagado e recriado).
TEST_DATABASE_URL=postgres://ascend:ascend@localhost:5432/ascend_test

# ─── Aplicação ──────────────────────────────────────────────────
# URL pública (usada em links de e-mail e no manifest do PWA).
APP_URL=http://localhost:3000

# Conta inicial do Presidente, criada por `npm run db:seed` caso não exista.
# A senha deve ter no mínimo 10 caracteres. Troque-a após o primeiro acesso.
BOOTSTRAP_PRESIDENT_EMAIL=
BOOTSTRAP_PRESIDENT_NAME=
BOOTSTRAP_PRESIDENT_PASSWORD=

# ─── E-mail (recuperação de senha) ──────────────────────────────
# Se SMTP_HOST ficar vazio, em desenvolvimento o link de redefinição é
# impresso no console do servidor; em produção nenhum e-mail é enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ascend CF <no-reply@example.com>"

# ─── Integração EA SPORTS FC ────────────────────────────────────
# A plataforma e o ID do clube são configurados na tela "Integração EA FC" (ficam no banco).
# EA_FC_PLATFORM e EA_FC_CLUB_ID abaixo são usados apenas pelo agente local.
# Plataforma do clube no Pro Clubs: common-gen5 (PS5/Xbox Series/PC) ou common-gen4.
EA_FC_PLATFORM=common-gen5
# ID numérico do clube no EA FC (preenchido também pelo painel de integração).
EA_FC_CLUB_ID=
# Token (mín. 24 caracteres) que autoriza a sincronização agendada pelo servidor: GET /api/integrations/ea-fc/sync.
SYNC_CRON_SECRET=
# Token do agente local (scripts/ea-sync-agent.mjs) para enviar partidas a /api/integrations/ea-fc/ingest.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"  (mín. 24 caracteres)
EA_SYNC_TOKEN=

# ─── Notificações push (Web Push, gratuito) ─────────────────────
# Gere com: npm run secrets   (a chave pública pode ser exposta; a privada não)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
